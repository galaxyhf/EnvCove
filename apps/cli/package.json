{
  "name": "envcove",
  "version": "0.1.0",
  "description": "Official CLI for EnvCove",
  "license": "MIT",
  "author": "Caio Silva",
  "preferGlobal": true,
  "keywords": [
    "env",
    "environment-variables",
    "secrets",
    "cli",
    "developer-tools"
  ],
  "homepage": "https://github.com/galaxyhf/EnvCove#readme",
  "bugs": {
    "url": "https://github.com/galaxyhf/EnvCove/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galaxyhf/EnvCove.git",
    "directory": "apps/cli"
  },
  "type": "module",
  "bin": {
    "envcove": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.0.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "ora": "^9.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
